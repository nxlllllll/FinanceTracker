{
    "RabbitMQ": {
        "Port": 5672,
        "ExchangeName": "finance-tracker",
        "QueueName": "transfer-projection",
        "MaxRetries": 5
    },
    "Redis": {
        "InstanceName": "ft:"
    },
    "Jwt": {
        "Issuer": "FinanceTracker",
        "Audience": "FinanceTracker",
        "AccessTokenTtlMinutes": 15,
        "RefreshTokenTtlDays": 7
    },
    "TransferCreditLag": {
        "IsEnabled": true,
        "IntervalMinutes": 5,
        "GracePeriodMinutes": 5,
        "CompensationThresholdMinutes": 30
    }
}