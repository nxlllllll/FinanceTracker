{
    "ConnectionStrings": {
        "FinanceTrackerContext": "Host=localhost;Database=FinanceTracker;Username=postgres;Password=nullReference@@1743;Pooling=true;MaxPoolSize=100"
    },
    "Jobs": {
        "Outbox": {
            "IntervalSeconds": 3,
            "BatchSize": 20,
            "MaxRetries": 5,
            "Group": "default",
            "TriggerName": "OutboxWorkerTrigger"
        },
        "DeadLetterMonitoring": {
            "IntervalMinutes": 5,
            "Group": "default",
            "TriggerName": "DeadLetterMonitoringTrigger"
        },
        "RecurringTransaction": {
            "CronExpression": "0 0 3 * * ?",
            "Group": "default",
            "TriggerName": "RecurringTransactionTrigger"
        }
    },
    "EventStore": {
        "SnapshotThreshold": 50
    }
}