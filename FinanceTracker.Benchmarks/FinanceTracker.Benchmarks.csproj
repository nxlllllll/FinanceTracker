<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.15.8" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.12.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FinanceTracker.Infrastructure\FinanceTracker.Infrastructure.csproj" />
        <ProjectReference Include="..\FinanceTracker.Core\FinanceTracker.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Exporters\analytics-template.html" />
        <None Remove="Exporters\analytics-styles.css" />
        <None Remove="Exporters\analytics-scripts.js" />
        <EmbeddedResource Include="Exporters\analytics-template.html" />
        <EmbeddedResource Include="Exporters\analytics-styles.css" />
        <EmbeddedResource Include="Exporters\analytics-scripts.js" />
        <None Update="Infrastructure\seed.sql">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>