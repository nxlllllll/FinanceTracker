{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "ft:"
  },
  "EventStore": {
    "SnapshotThreshold": 25,
    "PreValidateExpectedVersion": false
  },
  "Argon2": {
    "MemorySize": 65536,
    "Iterations": 3,
    "DegreeOfParallelism": 4,
    "HashLength": 32,
    "SaltLength": 16
  },
  "Jwt": {
    "Issuer": "FinanceTracker",
    "Audience": "FinanceTracker",
    "AccessTokenTtlMinutes": 15,
    "RefreshTokenTtlDays": 7
  }
}
