{
    "RabbitMQ": {
        "Port": 5672,
        "ExchangeName": "finance-tracker.domain-events"
    },
    "Redis": {
        "InstanceName": "ft:"
    },
    "Jwt": {
        "Issuer": "FinanceTracker",
        "Audience": "FinanceTracker",
        "AccessTokenTtlMinutes": 15,
        "RefreshTokenTtlDays": 7
    },
    "DomainEventOutbox": {
        "IsEnabled": true,
        "IntervalSeconds": 3,
        "BatchSize": 20,
        "MaxRetries": 5,
        "Group": "default",
        "TriggerName": "DomainEventOutboxTrigger"
    }
}