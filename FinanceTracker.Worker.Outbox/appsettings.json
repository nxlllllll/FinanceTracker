{
    "RabbitMQ": {
        "Port": 5672,
        "ExchangeName": "finance-tracker"
    },
    "Redis": {
        "InstanceName": "ft:"
    },
    "Jwt": {
        "Issuer": "FinanceTracker",
        "Audience": "FinanceTracker",
        "AccessTokenTtlMinutes": 15,
        "RefreshTokenTtlDays": 7
    },
    "Outbox": {
        "IsEnabled": true,
        "IntervalSeconds": 1,
        "BatchSize": 20,
        "MaxRetries": 5,
        "Group": "default",
        "TriggerName": "OutboxWorkerTrigger"
    }
}