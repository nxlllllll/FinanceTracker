{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "RabbitMQ": {
    "MaxReconnectDelaySeconds": 30,
    "ExchangeName": "finance-tracker"
  },
  "Outbox": {
    "IsEnabled": true,
    "IntervalSeconds": 1,
    "BatchSize": 20,
    "MaxRetries": 5,
    "Group": "default",
    "TriggerName": "OutboxWorkerTrigger"
  }
}
