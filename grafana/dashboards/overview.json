{
  "title": "FinanceTracker — Overview",
  "uid": "ft-overview",
  "tags": ["financetracker"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Services up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "expr": "count(up{job=~\"finance-tracker.*\"} == 1) or vector(0)", "legendFormat": "up", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 12 },
              { "color": "green", "value": 13 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Unhealthy checks",
      "description": "Any dependency reporting below Healthy. Green here is the fastest way to know the platform is fine; anything else names what is not.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        { "expr": "count(healthcheck < 2) or vector(0)", "legendFormat": "unhealthy", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Requests / sec",
      "description": "Excludes /metrics: Prometheus scrapes it every 15 seconds, which would otherwise show as a constant floor of traffic that has nothing to do with users.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_route!=\"/metrics\"}[5m])) or vector(0)",
          "legendFormat": "rps",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "fieldConfig": { "defaults": { "decimals": 2 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "5xx / sec",
      "description": "Server errors specifically. A steady trickle here is the signal that something is failing in a way nobody has noticed, since a 500 is answered and forgotten.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Outbox backlog",
      "description": "Unpublished messages. A number that grows rather than oscillates means the publisher is behind or stopped, and every projection downstream stops updating with it.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        { "expr": "max(outbox_pending) or vector(0)", "legendFormat": "pending", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Awaiting a human",
      "description": "Rows in unresolvable_events with no resolution. Each one is something the system could not fix on its own and will not retry.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        { "expr": "max(unresolvable_events_pending) or vector(0)", "legendFormat": "pending", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "state-timeline",
      "title": "Health checks over time",
      "description": "Worst state per check type across all services. Per-instance detail is deliberately left out: twenty-eight overlapping rows say less than five, and the alert carries the instance label when one actually fails.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "min by (healthcheck) (healthcheck)", "legendFormat": "{{healthcheck}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Unhealthy", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "Degraded", "color": "orange", "index": 1 } } },
            { "type": "value", "options": { "2": { "text": "Healthy", "color": "green", "index": 2 } } }
          ]
        },
        "overrides": []
      },
      "options": { "showValue": "never", "mergeValues": true }
    },
    {
      "type": "timeseries",
      "title": "Request duration",
      "description": "p50 and p99 together: the gap between them is usually more informative than either line, since a p99 pulling away while p50 holds means a subset of requests is doing something the rest are not.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route!=\"/metrics\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route!=\"/metrics\"}[5m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Messages waiting per queue. Flat near zero is healthy; a line climbing steadily means a consumer is slower than its producer or has stopped.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_messages_ready{queue!~\".*\\\\.dlq\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Dead letters",
      "description": "Messages that exceeded the delivery limit. Separate from the panel beside it because a backlog resolves itself and this does not — DeadLetterAuditListener records each one in unresolvable_events with its body.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_messages_ready{queue=~\".*\\\\.dlq\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20 },
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      }
    }
  ]
}
